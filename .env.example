# Copie para .env e ajuste. Todos são opcionais: os defaults do
# docker-compose.yml são estes mesmos valores.
#
# Credenciais só valem na PRIMEIRA subida do volume `pgdata`. Para trocar
# depois, é preciso recriar o volume (docker compose down -v apaga os dados!).
POSTGRES_USER=app_leetcode
POSTGRES_PASSWORD=app_leetcode
POSTGRES_DB=app_leetcode

# Fuso usado para decidir a virada de dia da sessão.
APP_TIMEZONE=America/Sao_Paulo

# Portas no host.
APP_PORT=8080
DB_HOST_PORT=5435
